rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isOwner() {
   return request.auth != null &&
     request.auth.uid == "COLE_AQUI_O_UID_DO_ADMIN";
  }
  match /produtos/{produtoId} {
   allow read: if true;
   allow create, update, delete: if isOwner();
  }
 }
}
